# ---------- Frontend (Vercel) ----------
# Base URL of the deployed Supabase Edge Function, without a trailing slash.
VITE_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1
# Bot username without the @, used by the fallback link and local demo.
VITE_BOT_USERNAME=taskon_bot
# Local UI preview only. Never set this in production.
VITE_DEMO=0

# ---------- Supabase Edge Function secrets ----------
# supabase secrets set BOT_TOKEN=... ADMIN_IDS=... BOT_USERNAME=...
BOT_TOKEN=123456:REPLACE_WITH_BOTFATHER_TOKEN
BOT_USERNAME=taskon_bot
# Comma-separated Telegram numeric IDs. Checked on every admin request.
ADMIN_IDS=111111111,222222222
# Optional: comma-separated origins allowed to call the function.
ALLOWED_ORIGINS=https://your-app.vercel.app

# ---------- Bot (Railway / Render) ----------
PUBLIC_URL=https://your-bot.onrender.com
WEBAPP_URL=https://your-app.vercel.app
# Optional Telegram webhook secret, sent in Telegram's secret-token header.
WEBHOOK_SECRET=
PORT=8080
